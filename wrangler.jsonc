{
  "name": "ricochet-rec",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-09",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "REC_STORE",
      "id": "00000000000000000000000000000001"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REC_DO",
        "class_name": "RecDO"
      }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RecDO"]
    }
  ]
}
