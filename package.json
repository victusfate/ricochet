{
  "name": "@victusfate/ricochet",
  "version": "2.1.1",
  "description": "Biased Matrix Factorization recommendation engine — Cloudflare Worker + standalone scoring library",
  "license": "MIT",
  "author": "victusfate",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./worker": "./src/index.ts"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "files": [
    "dist",
    "docs/api",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run docs:api",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8790",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && npm run typecheck",
    "test": "vitest run",
    "docs:api": "typedoc",
    "eval:movielens": "tsx --tsconfig tsconfig.scripts.json scripts/movielens-eval.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "recommendation",
    "matrix-factorization",
    "collaborative-filtering",
    "cloudflare-workers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/victusfate/ricochet.git"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.10",
    "@cloudflare/workers-types": "^4.20260409.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.5",
    "wrangler": "^4.81.0"
  }
}
