{
  "name": "@victusfate/ricochet",
  "version": "0.1.0",
  "description": "Biased Matrix Factorization recommendation engine — Cloudflare Worker + standalone scoring library",
  "license": "MIT",
  "author": "victusfate",
  "type": "module",
  "exports": {
    ".": {
      "types":   "./dist/lib.d.ts",
      "import":  "./dist/lib.js",
      "require": "./dist/lib.cjs"
    }
  },
  "main":  "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "files": [
    "dist",
    "src/lib.ts",
    "src/scoring.ts",
    "src/types.ts",
    "src/validation.ts"
  ],
  "scripts": {
    "build":           "tsup",
    "prepublishOnly":  "npm run typecheck && npm test && npm run build",
    "deploy":          "wrangler deploy",
    "dev":             "wrangler dev --port 8790",
    "cf-typegen":      "wrangler types",
    "typecheck":       "tsc --noEmit",
    "test":            "vitest run",
    "eval:movielens":  "tsx --tsconfig tsconfig.scripts.json scripts/movielens-eval.ts"
  },
  "keywords": ["recommendation", "matrix-factorization", "collaborative-filtering", "cloudflare-workers"],
  "repository": {
    "type": "git",
    "url": "https://github.com/victusfate/ricochet.git"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.1",
    "@cloudflare/workers-types": "^4.20260409.1",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.81.0"
  }
}
